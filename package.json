{
  "name": "cub-scouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.client.config.ts --port 3001 & tsx src/server/index.ts",
    "build": "tsc --project tsconfig.server.json && vite build --config vite.client.config.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.server.json && tsc --noEmit --project tsconfig.client.json"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
